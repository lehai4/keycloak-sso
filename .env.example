# Copy file này thành ".env" rồi điền thông tin DB thật.
# KHÔNG điền mật khẩu vào file này và KHÔNG commit file .env (đã có trong .gitignore).
#
# Nên dùng tài khoản MySQL CHỈ ĐỌC, ví dụ (chạy bằng tài khoản quản trị MySQL):
#   CREATE USER 'sso_readonly'@'%' IDENTIFIED BY '<mat-khau-manh>';
#   GRANT SELECT ON sync_data_hi_time_sheet.sync_nhan_vien TO 'sso_readonly'@'%';
#
# NV_DB_HOST: IP/tên máy chủ MySQL (giống HOSTMY_SQL bên tienich).
#   Nếu MySQL chạy ngay trên máy này thì ghi: host.docker.internal (KHÔNG ghi localhost)
NV_DB_HOST=
NV_DB_PORT=3306
NV_DB_USER=sso_readonly
NV_DB_PASSWORD=
NV_DB_SCHEMA=sync_data_hi_time_sheet
NV_DB_TABLE=sync_nhan_vien
